#!/usr/bin/env python3

"""
Usage: ./bin/build-from-bundle <input-bundle.json> <output-build.json> [extra-components.json]

Reads a bundle JSON and generates a fresh build.json. Optionally merges
in charts that are not managed by wire-release-manager: the EXTRA_CHARTS
table in this script, plus an optional extra_components.json file.

Components listed in the bundle's "exclude" list or missing a
"repository" field are skipped. Charts that are companions of
wire-server are automatically derived from the wire-server version.
"""

import json
import os
import sys
import urllib.error
import urllib.parse
import urllib.request

# Charts that wire-release-manager does not manage. They used to live in
# extra_components.json on the target branch and are inlined here; the optional
# extra-components.json argument is still merged after them, and never overrides them.
EXTRA_CHARTS = {
    "migrate-features": {
        "repo": "https://s3-eu-west-1.amazonaws.com/public.wire.com/charts",
        "version": "0.1.0",
    }
}

# Components in the bundle that are not helm charts and should be ignored
BUNDLE_IGNORE_COMPONENTS = [
    "zauth",
]

# The exact set of charts that must be present in the final build.json.
# The script fails if any are missing or if there are extraneous charts.

REQUIRED_CHARTS = [
    "account-pages",
    "cassandra-external",
    "coturn",
    "elasticsearch-external",
    "fake-aws-sqs",
    "ingress-nginx-controller",
    "ldap-scim-bridge",
    "migrate-features",
    "minio-external",
    "nginx-ingress-services",
    "rabbitmq-external",
    "reaper",
    "redis-ephemeral",
    "sftd",
    "smallstep-accomp",
    "step-certificates",
    "team-settings",
    "webapp",
    "wire-server",
]

S3_BASE_URLS = [
    "https://s3-eu-west-1.amazonaws.com/public.wire.com/charts",
    "https://s3-eu-west-1.amazonaws.com/public.wire.com/charts-develop",
]

# Charts that share wire-server's version and are published to the same
# S3 helm repo. These get derived automatically from the wire-server
# component in the bundle.
WIRE_SERVER_COMPANION_CHARTS = [
    "cassandra-external",
    "elasticsearch-external",
    "minio-external",
    "rabbitmq-external"
]

def oci_chart_exists(oci_base, name, version):
    """Check whether oci://<host>/<path>/<name>:<version> exists.

    Uses the OCI distribution API with an anonymous bearer token, which is
    enough for public repositories such as quay.io/wire/charts/*.
    """
    host, _, path = oci_base[len("oci://"):].partition("/")
    url = f"https://{host}/v2/{path}/{name}/manifests/{version}"
    accept = ",".join([
        "application/vnd.oci.image.manifest.v1+json",
        "application/vnd.oci.image.index.v1+json",
        "application/vnd.docker.distribution.manifest.v2+json",
    ])
    headers = {"Accept": accept}

    for _ in range(2):
        req = urllib.request.Request(url, method="HEAD", headers=headers)
        try:
            return urllib.request.urlopen(req).status == 200
        except urllib.error.HTTPError as e:
            if e.code != 401 or "Authorization" in headers:
                return False
            challenge = e.headers.get("WWW-Authenticate", "")
            if not challenge.lower().startswith("bearer "):
                return False
            params = dict(
                part.strip().split("=", 1)
                for part in challenge[len("bearer "):].split(",")
                if "=" in part
            )
            params = {k: v.strip('"') for k, v in params.items()}
            realm = params.pop("realm", None)
            if not realm:
                return False
            token_url = f"{realm}?{urllib.parse.urlencode(params)}"
            try:
                with urllib.request.urlopen(token_url) as resp:
                    token = json.load(resp).get("token")
            except urllib.error.URLError:
                return False
            if not token:
                return False
            headers["Authorization"] = f"Bearer {token}"
    return False


def find_published_chart(name, version, oci_base=None):
    """Find the repo URL where a chart is published.

    Tries the stable S3 charts repo first, then charts-develop, then (if
    oci_base is given) the OCI registry at <oci_base>/<name>.
    oci_base is the registry path without the chart name, e.g.
    oci://quay.io/wire/charts/stable (derived from wire-server's repository).
    Returns the base repo URL. Raises SystemExit if not found anywhere.
    """
    for base_url in S3_BASE_URLS:
        url = f"{base_url}/{name}-{version}.tgz"
        req = urllib.request.Request(url, method="HEAD")
        try:
            resp = urllib.request.urlopen(req)
            if resp.status == 200:
                print(f"  Found {name}-{version} at {base_url}")
                return base_url
        except urllib.error.HTTPError:
            continue

    if oci_base and oci_chart_exists(oci_base, name, version):
        print(f"  Found {name}-{version} at {oci_base}")
        return oci_base

    print(f"Error: chart {name}-{version} not found in any S3 or OCI repo")
    sys.exit(1)


def main():
    if len(sys.argv) < 3 or len(sys.argv) > 4:
        print(f"Usage: {sys.argv[0]} <input-bundle.json> <output-build.json> [extra-components.json]")
        sys.exit(1)

    input_path = sys.argv[1]
    output_path = sys.argv[2]
    extra_path = sys.argv[3] if len(sys.argv) == 4 else None

    with open(input_path) as f:
        bundle = json.load(f)

    # An exclusion cannot drop a chart the build requires: build.json must hold
    # exactly REQUIRED_CHARTS, so those are never treated as excluded.
    excludes = set(bundle.get("exclude", [])) - set(REQUIRED_CHARTS)
    ignores = set(BUNDLE_IGNORE_COMPONENTS)
    components = bundle.get("components", {})

    charts = {}
    added = 0
    skipped = 0

    for name, comp in components.items():
        if name in ignores:
            print(f"Skipping ignored (not a helm chart): {name}")
            skipped += 1
            continue

        if name in excludes:
            print(f"Skipping excluded: {name}")
            skipped += 1
            continue

        if "repository" not in comp:
            print(f"Skipping no repository: {name}")
            skipped += 1
            continue

        repo = comp["repository"]
        if repo.startswith("oci://"):
            repo = repo.rsplit("/", 1)[0]
        chart = {
            "repo": repo,
            "version": comp["version"],
        }

        meta = {}
        if "digest" in comp:
            meta["digest"] = comp["digest"]
        if meta:
            chart["meta"] = meta

        charts[name] = chart
        added += 1

    # Derive wire-server companion charts
    if "wire-server" in components:
        ws_version = components["wire-server"]["version"]
        ws_repo = components["wire-server"].get("repository", "")
        # oci://quay.io/wire/charts/stable/wire-server -> oci://quay.io/wire/charts/stable
        oci_base = ws_repo.rsplit("/", 1)[0] if ws_repo.startswith("oci://") else None
        print(f"Deriving companion charts for wire-server {ws_version}:")

        for name in WIRE_SERVER_COMPANION_CHARTS:
            if name in charts:
                print(f"  Skipping {name}: already in bundle")
                continue
            if name in excludes:
                print(f"  Skipping {name}: excluded")
                continue

            repo = find_published_chart(name, ws_version, oci_base)
            charts[name] = {
                "repo": repo,
                "version": ws_version,
            }
            added += 1

    # Merge extra components: the inlined ones first, then the optional file
    extras = dict(EXTRA_CHARTS)
    if extra_path:
        with open(extra_path) as f:
            for name, entry in json.load(f).get("helmCharts", {}).items():
                extras.setdefault(name, entry)
    if extras:
        for name, entry in extras.items():
            if name in charts:
                print(f"Extra: skipping {name}: already present")
                continue
            print(f"Extra: adding {name}")
            charts[name] = entry
            added += 1

    build = {
        "version": bundle.get("version", "0.0.0"),
        "helmCharts": charts,
    }

    print(f"Added {added} charts, skipped {skipped}")

    # Validate against required charts
    required = set(REQUIRED_CHARTS)
    actual = set(charts.keys())
    missing = sorted(required - actual)
    extraneous = sorted(actual - required)
    errors = False

    if missing:
        print(f"Error: missing required charts: {', '.join(missing)}")
        errors = True
    if extraneous:
        print(f"Error: extraneous charts: {', '.join(extraneous)}")
        errors = True
    if errors:
        sys.exit(1)

    print(f"Validated: all {len(required)} required charts present, no extraneous charts")

    with open(output_path, "w") as f:
        json.dump(build, f, indent=2)
        f.write("\n")


if __name__ == "__main__":
    main()
